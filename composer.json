{
  "name": "andersundsehr/rah",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "~8.5.12",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-zip": "*",
    "ondram/ci-detector": "^4.2.0",
    "phpstan/phpdoc-parser": "^2.3.6",
    "symfony/console": "^7.4.21",
    "symfony/dotenv": "^7.4.18",
    "symfony/finder": "^7.4.20",
    "symfony/flex": "^2.11.0",
    "symfony/framework-bundle": "^7.4.21",
    "symfony/http-client": "^7.4.21",
    "symfony/mime": "^7.4.19",
    "symfony/property-access": "^7.4.16",
    "symfony/property-info": "^7.4.20",
    "symfony/runtime": "^7.4.21",
    "symfony/serializer": "^7.4.21",
    "symfony/stopwatch": "^7.4.8",
    "symfony/twig-bundle": "^7.4.21",
    "symfony/validator": "^7.4.21",
    "symfony/web-profiler-bundle": "^7.4.21",
    "symfony/yaml": "^7.4.21",
    "thecodingmachine/safe": "^3.4.0"
  },
  "require-dev": {
    "guzzlehttp/psr7": "^2.13.2",
    "phpunit/phpunit": "^13.1.14",
    "pluswerk/grumphp-config": "^11.2.0",
    "symfony/browser-kit": "^7.4.21",
    "symfony/css-selector": "^7.4.18",
    "symfony/maker-bundle": "^1.68.0",
    "symfony/phpunit-bridge": "^7.4.21",
    "thecodingmachine/phpstan-safe-rule": "^1.4.7"
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "a9f/fractor-extension-installer": true,
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts",
      "composer normalize"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "test": "php -d pcov.enabled=1 vendor/bin/phpunit"
  }
}
